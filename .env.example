# Copie este arquivo para .env e preencha os valores.

# Porta da API (a EC2 do Terraform espera 3000)
PORT=3000

# String de conexão do PostgreSQL no Aiven (Service URI no painel do Aiven).
# Exemplo: postgres://avnadmin:SENHA@clutch-db-projeto.aivencloud.com:12345/defaultdb?sslmode=require
DATABASE_URL="postgresql://usuario:senha@localhost:5432/clutch?sslmode=require"

# Origem permitida pelo CORS (URL do frontend em desenvolvimento)
CORS_ORIGIN=http://localhost:5173

# Chave para assinar os tokens de login. Gere uma com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-string-aleatoria-de-pelo-menos-32-caracteres"

# Envio de emails (códigos de cadastro e de login, esqueci a senha) pelo Gmail do projeto.
# SMTP_USER: o endereço do Gmail. SMTP_PASS: uma "senha de app" do Google (não é a senha da conta):
# https://myaccount.google.com/apppasswords (precisa da verificação em 2 etapas ligada).
# Sem SMTP_USER e SMTP_PASS, os emails não são enviados: o código aparece no terminal do backend.
SMTP_USER=
SMTP_PASS=
# Opcionais: servidor (padrão smtp.gmail.com, porta 465) e remetente (padrão: o próprio SMTP_USER)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
MAIL_FROM_NAME=Clutch

# Emails (separados por vírgula) que viram administradores ao confirmar a conta ou fazer login
ADMIN_EMAILS=
