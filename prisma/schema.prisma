// Schema do banco de dados do Clutch.
// Após alterar este arquivo, rode `npm run db:migrate` para gerar e aplicar a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USUÁRIOS
// ==========================================

enum UserRole {
  USER
  ADMIN
}

enum SkateLevel {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
  PROFISSIONAL
}

model User {
  id              String      @id @default(uuid())
  name            String
  username        String      @unique
  email           String      @unique
  passwordHash    String
  avatarUrl       String?
  bio             String?
  skateLevel      SkateLevel?
  role            UserRole    @default(USER)
  // Preenchido quando a pessoa clica no link do email. Enquanto for nulo, o login fica bloqueado.
  emailVerifiedAt DateTime?
  // Data de nascimento (só a data, sem hora). Nula nas contas criadas antes de o cadastro pedir:
  // nesse caso a idade conta como "não verificada" e spots e marketplace ficam bloqueados.
  birthDate       DateTime?   @db.Date
  // Aumenta toda vez que a senha muda. Cada login guarda o número da época em que foi feito;
  // se o número da conta já é outro, aquele login deixa de valer (derruba as sessões antigas).
  tokenVersion    Int         @default(0)
  // Preenchido quando um administrador suspende a conta: a pessoa não consegue entrar
  // e os posts dela somem da comunidade até a suspensão ser retirada.
  suspendedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  avatar              UserAvatar?
  posts               Post[]
  comments            Comment[]
  likes               Like[]
  followers           Follow[]                 @relation("following")
  following           Follow[]                 @relation("follower")
  spots               Spot[]
  meetups             Meetup[]
  participations      MeetupParticipant[]
  cartItems           CartItem[]
  orders              Order[]
  savedPosts          SavedPost[]
  savedProducts       SavedProduct[]
  conversationsA      Conversation[]           @relation("conversationUserA")
  conversationsB      Conversation[]           @relation("conversationUserB")
  messages            Message[]

  @@map("users")
}

// Link de "esqueci minha senha" enviado por email. Assim como na confirmação de email,
// só o hash do token fica salvo. Vale por 1 hora e só pode ser usado uma vez.
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Foto de perfil, guardada no banco (JPEG pequeno, já recortado pelo site).
// Fica numa tabela separada para não ser carregada em toda consulta de usuário.
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  updatedAt DateTime @updatedAt

  @@map("user_avatars")
}

// Link de confirmação de email enviado no cadastro.
// Só o hash (SHA-256) do token fica salvo: quem tiver acesso ao banco não consegue usar os links.
model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  // Código de 6 dígitos (também em hash) para quem prefere digitar em vez de clicar no link
  codeHash  String
  // Tentativas erradas do código: depois de 5, é preciso pedir um novo
  attempts  Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// ==========================================
// REDE SOCIAL
// ==========================================

model Post {
  id        String   @id @default(uuid())
  // Texto do post (pode ficar vazio quando o post é só uma foto)
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]
  likes    Like[]
  images   PostImage[]
  savedBy  SavedPost[]
  sharedIn Message[]

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@map("posts")
}

// Fotos de um post (até 4), guardadas no banco como a foto de perfil
model PostImage {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  data      Bytes
  // Ordem em que a pessoa escolheu as fotos
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([postId, position])
  @@map("post_images")
}

// Posts que a pessoa guardou para ver depois
model SavedPost {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([userId, createdAt])
  @@map("saved_posts")
}

// Produtos da loja que a pessoa guardou
model SavedProduct {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
  @@index([userId, createdAt])
  @@map("saved_products")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@map("comments")
}

model Like {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@map("likes")
}

model Follow {
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// ==========================================
// MARKETPLACE
// ==========================================

enum OrderStatus {
  PENDENTE
  PAGO
  ENVIADO
  ENTREGUE
  CANCELADO
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  logoUrl     String?
  website     String?
  createdAt   DateTime @default(now())

  products Product[]

  @@map("brands")
}

// Tipo do produto: decide quais detalhes aparecem na ficha (ex.: shape tem madeira e estado)
enum ProductCategory {
  ROUPA
  CALCADO
  SHAPE
  SKATE_MONTADO
  PECAS
  ACESSORIO
  OUTRO
}

model Product {
  id          String          @id @default(uuid())
  name        String
  description String
  price       Decimal         @db.Decimal(10, 2)
  active      Boolean         @default(true)
  category    ProductCategory @default(OUTRO)
  // Ficha de detalhes: lista de { label, value } (ex.: { "label": "Madeira", "value": "Maple canadense" })
  details     Json            @default("[]")
  // Perguntas frequentes do produto: lista de { question, answer }
  faq         Json            @default("[]")
  // Onde o produto está (bairro, cidade), mostrado no anúncio. Opcional.
  location    String?
  brandId     String
  brand       Brand           @relation(fields: [brandId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  variants ProductVariant[]
  images   ProductImage[]
  savedBy  SavedProduct[]

  @@index([brandId])
  @@index([category])
  @@map("products")
}

// Fotos dos produtos, guardadas no banco (JPEG já recortado e reduzido pelo site),
// do mesmo jeito que a foto de perfil. São servidas por GET /products/images/:id
model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  data      Bytes
  // Ordem em que aparece na página do produto (a de menor número é a capa)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
  @@map("product_images")
}

// Cada tamanho de um produto tem seu próprio estoque (ex.: camiseta P, M, G)
model ProductVariant {
  id        String  @id @default(uuid())
  size      String
  stock     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size])
  @@map("product_variants")
}

model CartItem {
  id        String         @id @default(uuid())
  quantity  Int
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
  @@map("cart_items")
}

model Order {
  id     String      @id @default(uuid())
  status OrderStatus @default(PENDENTE)
  total  Decimal     @db.Decimal(10, 2)
  userId String
  // Excluir a conta apaga também os pedidos dela (direito de exclusão dos dados)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Endereço de entrega, copiado para o pedido: fica como era no dia da compra
  recipientName String
  zipCode       String
  street        String
  addressNumber String
  complement    String?
  district      String
  city          String
  state         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(uuid())
  quantity    Int
  // Preço, nome, marca e tamanho copiados no momento da compra, para o histórico não mudar
  // se o produto for editado ou apagado depois
  unitPrice   Decimal         @db.Decimal(10, 2)
  productName String
  brandName   String
  size        String
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Fica nulo se o produto (ou o tamanho) for apagado da loja
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

// ==========================================
// SPOTS E ENCONTROS
// ==========================================

enum SpotType {
  STREET
  PISTA
  BOWL
  MINI_RAMP
  DIY
  OUTRO
}

model Spot {
  id          String   @id @default(uuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  type        SpotType @default(STREET)
  imageUrls   String[]
  // Opcional para o spot continuar existindo se quem criou apagar a conta
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  meetups Meetup[]

  @@index([latitude, longitude])
  @@map("spots")
}

model Meetup {
  id          String   @id @default(uuid())
  title       String
  description String?
  startsAt    DateTime
  spotId      String
  spot        Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  participants MeetupParticipant[]

  @@index([spotId, startsAt])
  @@map("meetups")
}

model MeetupParticipant {
  meetupId String
  meetup   Meetup   @relation(fields: [meetupId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([meetupId, userId])
  @@map("meetup_participants")
}

// ==========================================
// CHAT ENTRE AMIGOS
// ==========================================

// Conversa entre duas pessoas. userA é sempre o id "menor" (ordem alfabética), assim cada
// par tem uma conversa só. Cada lado guarda até quando já leu (para contar as não lidas).
model Conversation {
  id            String    @id @default(uuid())
  userAId       String
  userA         User      @relation("conversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId       String
  userB         User      @relation("conversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  userAReadAt   DateTime?
  userBReadAt   DateTime?
  // Data da última mensagem: a lista de conversas vem ordenada por ela
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
  @@map("conversations")
}

// Mensagem de texto e/ou um post compartilhado. Se o post for apagado, a mensagem fica
// (postId vira nulo e o site mostra "post indisponível").
model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  postId         String?
  post           Post?        @relation(fields: [postId], references: [id], onDelete: SetNull)
  // Marca que a mensagem levava um post (para saber que ele foi apagado depois)
  sharedPost     Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}
